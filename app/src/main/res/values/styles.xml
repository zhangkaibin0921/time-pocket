<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#AE462F</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FAF7F0</item>
        <item name="android:statusBarColor">#FAF7F0</item>
        <item name="android:navigationBarColor">#FAF7F0</item>
    </style>
    <style name="PocketDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:textColorPrimary">#283D38</item>
        <item name="android:textColorSecondary">#5F6D65</item>
        <item name="android:colorAccent">#284B40</item>
        <item name="android:windowBackground">#FAF7F0</item>
    </style>
    <style name="PocketSheetMotion" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/pocket_sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/pocket_sheet_exit</item>
    </style>
</resources>
